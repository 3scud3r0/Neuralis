# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NEURALIS_WORKER_DIR=/work \
    NEURALIS_WORKER_CPU_THREADS=2 NEURALIS_WORKER_MEMORY_MB=512
WORKDIR /opt/neuralis/worker
COPY services/worker/pyproject.toml ./
COPY services/worker/neuralis_worker ./neuralis_worker
RUN --mount=type=secret,id=system_ca,required=false \
    if [ -f /run/secrets/system_ca ]; then export PIP_CERT=/run/secrets/system_ca; fi; \
    pip install --no-cache-dir --disable-pip-version-check . && \
    groupadd --gid 10001 neuralis && useradd --uid 10001 --gid neuralis --no-create-home neuralis && \
    mkdir -p /work && chown neuralis:neuralis /work
USER 10001:10001
CMD ["python", "-m", "neuralis_worker"]
